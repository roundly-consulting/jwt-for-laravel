{
    "name": "roundly-consulting/jwt-for-laravel",
    "description": "Native RS256 user tokens and HS256 service tokens, guards, jti denylist and claim-based authorization for Laravel — zero third-party crypto.",
    "keywords": [
        "roundly-consulting",
        "laravel",
        "jwt",
        "jws",
        "rs256",
        "hs256",
        "auth"
    ],
    "homepage": "https://roundly-consulting.com/open-source/docs/jwt-for-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Andrej Mihaliak",
            "email": "andrej@mihaliak.com",
            "role": "Developer"
        }
    ],
    "support": {
        "docs": "https://roundly-consulting.com/open-source/docs/jwt-for-laravel"
    },
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "ext-openssl": "*",
        "illuminate/auth": "^12.0|^13.0",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "roundly-consulting/crypto-for-laravel": "^1.0",
        "roundly-consulting/enums-for-laravel": "^1.0",
        "roundly-consulting/package-toolkit-for-laravel": "^1.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "roundly-consulting/testing-for-laravel": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "RoundlyConsulting\\Jwt\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RoundlyConsulting\\Jwt\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --no-progress",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage --min=95"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RoundlyConsulting\\Jwt\\JwtServiceProvider"
            ],
            "aliases": {
                "Jwt": "RoundlyConsulting\\Jwt\\Facades\\Jwt"
            }
        }
    }
}
